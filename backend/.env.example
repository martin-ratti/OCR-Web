# ─────────────────────────────────────────────────────────────
# OCR-Web backend — variables de entorno
# Copiar este archivo a backend/.env y completar las keys.
# Las dos API keys son OPCIONALES en boot (Zod .optional()):
#   - Sin GEMINI_API_KEY → requests con engine=gemini devuelven 503.
#   - Sin GROQ_API_KEY   → requests con engine=groq   devuelven 503.
#   - El motor "paddle" (Local) corre 100% en el navegador mediante
#     PaddleOCR ONNX Web Worker (PP-OCRv6_small + WebGPU/WASM) —
#     no necesita ninguna key ni golpea al servidor.
# ─────────────────────────────────────────────────────────────

# Google AI Studio (https://aistudio.google.com/) — motor Gemini.
# Usa exclusivamente modelos ultraligeros Flash-Lite / Flash (nunca Pro).
GEMINI_API_KEY=

# Modelo primario ligero de Gemini y cascada automática de respaldo ante 429/503/504.
# GEMINI_MODEL_ID=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# Límite de solicitudes concurrentes hacia Gemini en servidor (protege cuota RPM).
# GEMINI_MAX_CONCURRENCY=3

# Groq Console (https://console.groq.com/keys) — motor Groq multimodal LPU.
# Free tier 1000 RPD / 30 RPM. Recomendado para lotes intensivos.
GROQ_API_KEY=

# Opcional — override del modelo multimodal en Groq (ej. qwen/qwen3.8-27b o Llama 4 Scout).
# GROQ_MODEL_ID=qwen/qwen3.8-27b

# Token opcional para consultar GET /metrics (Bearer token).
# En producción (NODE_ENV=production), si no se define METRICS_TOKEN, /metrics queda bloqueado (403).
# METRICS_TOKEN=

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP local (Render lo setea solo en prod — dejar comentado).
# PORT=3001

# CORS whitelist (CSV). En dev local los defaults ya cubren Vite y preview.
# En producción poner la URL de Vercel: https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
