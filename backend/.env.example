# ─────────────────────────────────────────────────────────────
# OCR-Web backend — variables de entorno
# Copiar este archivo a backend/.env y completar las keys.
# Las dos API keys son OPCIONALES en boot (Zod .optional()):
#   - Sin GEMINI_API_KEY → requests con engine=gemini tiran 500.
#   - Sin GROQ_API_KEY   → requests con engine=groq   tiran 500.
#   - El motor "paddle" (Local) corre 100% en el browser via
#     tesseract.js — no necesita ninguna key.
# ─────────────────────────────────────────────────────────────

# Google AI Studio (https://aistudio.google.com/) — motor Gemini.
# Prompt de resaltado estricto, alta precisión, free tier ~20 RPD.
GEMINI_API_KEY=

# Groq Console (https://console.groq.com/keys) — motor Groq Llama 4 Scout.
# Prompt de pagina completa, ~96% word recall vs Gemini, ~10x mas rapido.
# Free tier 1000 RPD / 30 RPM. Recomendado para uso intensivo.
GROQ_API_KEY=

# Opcional — override del modelo Groq si Llama 4 Scout es deprecado/renombrado.
# GROQ_MODEL_ID=meta-llama/llama-4-scout-17b-16e-instruct

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP local (Render lo setea solo en prod — dejar comentado).
# PORT=3001

# CORS whitelist (CSV). En dev local los defaults ya cubren Vite y preview.
# En produccion poner la URL de Vercel: https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
